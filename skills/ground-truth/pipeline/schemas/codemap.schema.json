{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codemap finder output (one instance per coverage root)",
  "type": "object",
  "required": ["components", "orphan_files", "written_to"],
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "root", "entry_point", "language", "existing_tests", "importers"],
        "properties": {
          "component": { "type": "string" },
          "root": { "type": "string" },
          "entry_point": { "type": "string" },
          "language": { "type": "string" },
          "existing_tests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "importers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "note": { "type": "string" }
        }
      }
    },
    "orphan_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "written_to": { "type": "string" }
  }
}
